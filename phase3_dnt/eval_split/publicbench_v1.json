 "why": "Second GUAVA-FB evaluation on public avatar benchmarks with their PUBLISHED train / test splits and pose sources (PREREG 'PublicBench-v1'); rendering, crops and metrics are AvatarTest-v1's, so absolute numbers are not comparable with the papers' tables (other resolutions / crops / backgrounds).",
 "protocol": {
  "frames": "per clip, the ordered list 'frames' = published train frames + published test frames (val frames unused)",
  "source": "source_frame = the first training frame; single-image methods (GUAVA, GUAVA-FB) see only this frame",
  "recon": "recon_frames = the PUBLISHED TRAIN frames (explicit list; NOT the first half); per-subject methods train on these only",
  "test": "test_frames = the PUBLISHED TEST frames; every method is scored on exactly these",
  "driving": "GT rows: the dataset's published SMPL of each test frame (SMPL-X 2020 fitted to it for SMPL-X methods); estimator rows (SPRINT): the estimator's per-frame output",
  "gt_body_model": "SMPL; People-Snapshot gendered (InstantAvatar / GART), NeuMan neutral (NeuMan)",
  "smplx_conversion": "SMPL-X 2020 fitted to the GT SMPL mesh via PEAR's smplx2smpl correspondence: one betas200 per clip, per-frame root + 21 body joints + translation; jaw / eyes / fingers 0 (flat hands), exp 0; residual reported",
  "metrics": "AvatarTest-v1 (GUAVA main/metrics.py PSNR, L1, SSIM, LPIPS-VGG on the 512 perspective person crop; GT = image x StyleMatte alpha on black; mean per clip, frame-weighted; per dataset and overall)",
  "mask": "StyleMatte (EHM-Tracker stylematte_synth.pt) on the 1024 crop (the datasets' own masks are not used)",
  "crop": "AvatarTest-v1 perspective crop: aimed at / sized by the projected GT SMPL mesh box clipped to the image, 1.1 x, 1024 px"
 },
